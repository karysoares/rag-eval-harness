# Copie para .env (nunca faça commit do .env). Não commite chaves API.
# O comando `llm-eval` carrega este ficheiro automaticamente (não precisa de `source`).

# ── Gerador (respondedor) ───────────────────────────────────────────────────
# Qualquer endpoint compatível com OpenAI. A base pode ou não terminar em /v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ── Juiz ────────────────────────────────────────────────────────────────────
# O juiz deve ser DISTINTO do gerador: um modelo que avalia as suas próprias
# respostas tende a preferi-las (auto-referência). Sem JUDGE_BASE_URL o juiz usa
# o mesmo endpoint do gerador; defina-o para os separar.
JUDGE_MODEL=gpt-4o
# JUDGE_BASE_URL=
# JUDGE_API_KEY=          # se omitida, reutiliza OPENAI_API_KEY

# ── Presets de fornecedor ───────────────────────────────────────────────────
# O juiz domina o custo de uma corrida (~$2,80 de ~$3,15 em 1025 itens com
# gpt-4o). Mantê-lo local é a poupança maior — e reforça a independência entre
# gerador e juiz. Verifique sempre com `--judge-report` se o juiz que escolheu
# é calibrado e discriminativo: um modelo pequeno pode reprovar tudo e parecer
# bom num teste curto.

# Ollama local — gratuito, sem chave real (o endpoint ignora-a, mas exige uma).
#   ollama pull qwen2.5:7b
# JUDGE_BASE_URL=http://localhost:11434
# JUDGE_API_KEY=ollama
# JUDGE_MODEL=qwen2.5:7b            # 3/3 no smoke de vereditos; ~50 s/item num M3 16 GB
# JUDGE_MODEL=deepseek-r1:8b        # ~19 s/item; o parse tolera o traço de raciocínio
# JUDGE_MODEL=llama3.1:8b           # útil como terceiro juiz para concordância entre famílias
# Evite mistral:7b (não devolve o schema JSON) e qwen2.5:3b (reprova tudo).

# vLLM local (mais rápido que Ollama em lote; requer GPU)
# JUDGE_BASE_URL=http://localhost:8000/v1
# JUDGE_API_KEY=vllm

# DeepSeek (API própria, compatível com OpenAI)
# JUDGE_BASE_URL=https://api.deepseek.com
# JUDGE_API_KEY=sk-...
# JUDGE_MODEL=deepseek-chat

# Qwen / DashScope (modo compatível; use a região correta)
# JUDGE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# JUDGE_API_KEY=sk-...
# JUDGE_MODEL=qwen-plus

# OpenRouter (agrega vários fornecedores, incluindo variantes gratuitas)
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_API_KEY=sk-or-...
# JUDGE_MODEL=qwen/qwen-2.5-7b-instruct

# ── Custo e observabilidade ─────────────────────────────────────────────────
# Custo por modelo (recomendado): modelo:prompt:completion por 1M tokens.
# Um par único aplicado a gerador e juiz distintos erra por ~10x.
# O nome pode conter ':' (etiquetas do Ollama); a separação é pela direita.
# Modelos locais entram a zero para ficarem no total em vez de "sem preço".
# LLM_EVAL_PRICES=gpt-4o-mini:0.15:0.60,gpt-4o:2.50:10.00,qwen2.5:7b:0:0
#
# Legado: preço único aplicado a todos os modelos. Só correcto se gerador e
# juiz usarem o mesmo modelo.
# OPENAI_PRICE_PER_1M_PROMPT=0.15
# OPENAI_PRICE_PER_1M_COMPLETION=0.60

# ── Execução ────────────────────────────────────────────────────────────────
# Itens em paralelo (sobrepõe-se a llm.concurrency no YAML). A ordem de
# predictions.jsonl não depende disto. Com juiz local, mantenha baixo.
# LLM_EVAL_CONCURRENCY=4
# Pacing entre itens, em segundos (respeitado também com concorrência > 1)
# LLM_EVAL_INTER_ITEM_SLEEP=0

# ── Telemetria (opcional) ───────────────────────────────────────────────────
# Destinos separados por vírgulas: jsonl, phoenix, langsmith, otlp, cloudwatch.
# `jsonl` não precisa de nada; os OTLP precisam de `uv sync --extra observability`.
# LLM_EVAL_TELEMETRY=jsonl
# LLM_EVAL_TELEMETRY_PROJECT=rag-eval-harness
# Exporta pergunta/resposta para o backend. Desligado por omissão de propósito.
# LLM_EVAL_TELEMETRY_CONTENT=0
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# LANGSMITH_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# LLM_EVAL_CLOUDWATCH_NAMESPACE=RagEvalHarness

# ── Hugging Face ────────────────────────────────────────────────────────────
# Só se datasets privados ou limites de taxa
HF_TOKEN=

# Testes de integração que chamam a API real (não usar no CI)
RUN_INTEGRATION=0
