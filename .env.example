# Copie para .env (nunca faça commit do .env). Não commite chaves API.
# O comando `llm-eval` carrega este ficheiro automaticamente (não precisa de `source`).

# API compatível com OpenAI (obrigatória para geração e juiz em `llm-eval`)
OPENAI_API_KEY=
# Opcional (Azure, proxy local, Ollama com compatível OpenAI, etc.)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Juiz deve ser modelo DISTINTO do gerador (evita auto-referência na avaliação).
# Se omitido, JUDGE_MODEL cai no mesmo valor que LLM_MODEL — válido só para smoke local.
JUDGE_MODEL=gpt-4o
# Opcional: custo estimado no summary.json (USD por 1M tokens)
# OPENAI_PRICE_PER_1M_PROMPT=0.15
# OPENAI_PRICE_PER_1M_COMPLETION=0.60

# Hugging Face (só se datasets privados ou limites de taxa)
HF_TOKEN=

# Testes de integração que chamam a API real (não usar no CI)
RUN_INTEGRATION=0
